# Supabase — create a project at supabase.com, find these in Settings > API.
# NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY are used by the
# SSR + browser clients (@supabase/ssr). SUPABASE_SERVICE_ROLE_KEY stays
# server-only and powers the admin client (companies, reports, exa_search_cache).
# Legacy SUPABASE_URL is still accepted as a fallback by the admin client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google OAuth + email magic-link providers are configured in the Supabase
# dashboard (Authentication > Providers), not via env vars. Whitelist
# <your-origin>/auth/callback under Authentication > URL Configuration.

# Optional. Server-side fallback OpenRouter API key (https://openrouter.ai/keys).
# All inference routes through OpenRouter. When set, the server uses this for
# any /api/research request that arrives without an x-openrouter-key header.
# Leave blank for hosted public deployments to force every user to BYOK.
# OPENROUTER_API_KEY=

# Optional. Server-side fallback web-search API key. Search is REQUIRED, not
# optional: no model in the map ships a built-in web search, so a request with
# no search key fails with missing_search_key. Defaults to EXA (https://exa.ai);
# set SEARCH_PROVIDER to route the server fallback through a different backend.
# Same BYOK rule as above — leave blank on public deployments.
# EXA_API_KEY=

# Optional. Search backend for the server-side fallback key: exa | firecrawl | tavily.
# Defaults to "exa". Per-user keys carry their own provider on the request
# (x-search-key + x-search-provider travel together), so this only affects the
# operator's own fallback key.
# SEARCH_PROVIDER=exa

# Optional. Model overrides, for the eval harness only — the product UI never
# sets these. Defaults: google/gemini-3.1-flash-lite and deepseek/deepseek-v4-pro.
# FS_MODEL_DEFAULT=
# FS_MODEL_REASONING=

# Mock mode — set "true" to replay fixture data instead of calling OpenRouter/Supabase.
# Use for frontend development. Only the "anthropic" company (the fixture
# subject) is available in mock mode.
# MOCK_RESEARCH=true
