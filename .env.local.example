# Supabase — create a project at supabase.com, find these in Settings > API.
# NEXT_PUBLIC_SUPABASE_URL is consumed by both server and browser clients via @supabase/ssr.
# Legacy SUPABASE_URL is still accepted as a fallback by the admin client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional. Server-side fallback Anthropic API key.
# When set, the server uses this for any /api/research request that
# arrives without an x-anthropic-key header. Leave blank for hosted
# public deployments to force every user to BYOK.
# ANTHROPIC_API_KEY=

# Optional. Server-side fallback Kimi (Moonshot) API key.
# When set alongside EXA_API_KEY, the server routes /api/research
# requests without an x-anthropic-key header through Kimi K2.6 at
# https://api.moonshot.ai/v1. Anthropic still wins ties when both
# ANTHROPIC_API_KEY and KIMI_API_KEY are present.
# KIMI_API_KEY=

# Optional. EXA web-search API key (https://exa.ai). Required when
# routing through Kimi (Kimi has no built-in compatible web search);
# optional when using Anthropic (it falls back to native web_search).
# EXA_API_KEY=

# Mock mode — set "true" to replay fixture data instead of calling Anthropic/Supabase.
# Use for frontend development. Only "anthropic" company available in mock mode.
# MOCK_RESEARCH=true
