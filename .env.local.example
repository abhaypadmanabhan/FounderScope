# Supabase — create a project at supabase.com, find these in Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional. Server-side fallback Anthropic API key.
# When set, the server uses this for any /api/research request that
# arrives without an x-anthropic-key header. Leave blank for hosted
# public deployments to force every user to BYOK.
# ANTHROPIC_API_KEY=

# Mock mode — set "true" to replay fixture data instead of calling Anthropic/Supabase.
# Use for frontend development. Only "anthropic" company available in mock mode.
# MOCK_RESEARCH=true
